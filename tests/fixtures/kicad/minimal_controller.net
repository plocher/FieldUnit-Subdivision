(export (version "E")
  (design
    (source "minimal_controller.kicad_sch")
    (date "2026-09-29")
    (tool "hand-written fixture"))
  (components
    (comp (ref "MACHINE1")
      (value "Test Machine")
      (fields
        (field (name "Role") "MACHINE")
        (field (name "Type") "US&S506")
        (field (name "Columns") "2"))
      (libsource (lib "RailroadPanel") (part "CtcMachine"))
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "COL1")
      (value "1")
      (fields
        (field (name "Role") "COLUMN")
        (field (name "CP Name") "CP Alpha"))
      (libsource (lib "RailroadPanel") (part "PanelColumn"))
      (sheetpath (names "/Alpha/") (tstamps "/aaaa/")))
    (comp (ref "SW1")
      (value "10")
      (fields
        (field (name "Role") "APPLIANCE")
        (field (name "Kind") "SWITCH_LEVER"))
      (libsource (lib "RailroadPanel") (part "PanelSwitch"))
      (sheetpath (names "/Alpha/") (tstamps "/aaaa/")))
    (comp (ref "CODE1")
      (value "CODE")
      (fields
        (field (name "Role") "APPLIANCE")
        (field (name "Kind") "CODE"))
      (libsource (lib "RailroadPanel") (part "PanelCode"))
      (sheetpath (names "/Alpha/") (tstamps "/aaaa/")))
    (comp (ref "LAMP1")
      (value "OS")
      (fields
        (field (name "Role") "APPLIANCE")
        (field (name "Kind") "LAMP")
        (field (name "IndicationToken") "10T1"))
      (libsource (lib "RailroadPanel") (part "PanelLamp-RED"))
      (sheetpath (names "/Alpha/") (tstamps "/aaaa/")))
    (comp (ref "CODELINE1")
      (value "VIRTUAL")
      (fields
        (field (name "Role") "CODELINE")
        (field (name "Station") "Alpha"))
      (libsource (lib "RailroadPanel") (part "Codeline-Virtual"))
      (sheetpath (names "/Alpha/") (tstamps "/aaaa/")))
    (comp (ref "U1")
      (value "0x20")
      (fields
        (field (name "Role") "IODRIVER")
        (field (name "BusKind") "I2C-MAX7313"))
      (libsource (lib "RailroadPanel") (part "PanelColumn-MAX7313"))
      (sheetpath (names "/Alpha/") (tstamps "/aaaa/"))))
  (nets
    (net (code "1") (name "Net-(SW1-Column)")
      (node (ref "COL1") (pin "5") (pinfunction "Column_5") (pintype "free"))
      (node (ref "SW1") (pin "1") (pinfunction "Column_1") (pintype "passive")))
    (net (code "2") (name "Net-(SW1-NWS)")
      (node (ref "SW1") (pin "2") (pinfunction "NWS_2") (pintype "output"))
      (node (ref "U1") (pin "8") (pinfunction "bit7_8") (pintype "input")))
    (net (code "3") (name "Net-(SW1-RWS)")
      (node (ref "SW1") (pin "3") (pinfunction "RWS_3") (pintype "output"))
      (node (ref "U1") (pin "7") (pinfunction "bit6_7") (pintype "input")))
    (net (code "4") (name "Net-(SW1-NWK)")
      (node (ref "SW1") (pin "5") (pinfunction "NWK_5") (pintype "input"))
      (node (ref "U1") (pin "1") (pinfunction "bit0_1") (pintype "output")))
    (net (code "5") (name "Net-(SW1-RWK)")
      (node (ref "SW1") (pin "4") (pinfunction "RWK_4") (pintype "input"))
      (node (ref "U1") (pin "2") (pinfunction "bit1_2") (pintype "output")))
    (net (code "6") (name "Net-(CODE1-Column)")
      (node (ref "COL1") (pin "7") (pinfunction "Column_7") (pintype "free"))
      (node (ref "CODE1") (pin "1") (pinfunction "Column_1") (pintype "passive")))
    (net (code "7") (name "Net-(CODE1-CODE)")
      (node (ref "CODE1") (pin "2") (pinfunction "CODE_2") (pintype "output"))
      (node (ref "U1") (pin "13") (pinfunction "bit12_13") (pintype "input")))
    (net (code "8") (name "Net-(LAMP1-Column)")
      (node (ref "COL1") (pin "1") (pinfunction "Column_1") (pintype "free"))
      (node (ref "LAMP1") (pin "1") (pinfunction "Column_1") (pintype "passive")))
    (net (code "9") (name "Net-(LAMP1-LAMP)")
      (node (ref "LAMP1") (pin "2") (pinfunction "LAMP_2") (pintype "input"))
      (node (ref "U1") (pin "4") (pinfunction "bit3_4") (pintype "output")))))
