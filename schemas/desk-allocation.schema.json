{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldunit.org/schema/v1/desk-allocation.schema.json",
  "title": "FieldUnit Constructed Desk Allocation",
  "type": "object",
  "required": ["kind", "version", "id", "codingSystem", "columns"],
  "properties": {
    "kind": {
      "const": "desk-allocation"
    },
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "codingSystem": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/column"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "column": {
      "type": "object",
      "required": ["id", "ordinal", "controlledPointId", "codeGroupId"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "controlledPointId": {
          "$ref": "#/$defs/id"
        },
        "interlockingPlantIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "codeGroupId": {
          "$ref": "#/$defs/id"
        },
        "controlTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+S$"
          },
          "uniqueItems": true
        },
        "indicationTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+K$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
