{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spcoast.com/schemas/layout-model/v2.0.0.json",
  "title": "Layout Data Model File",
  "description": "ADR 0008. One file holds one layout: what a person states, nested by scope, every relation a qualified railroad name. Absent is absent. Nothing here names a sheet, a net, a reference or a unit.",
  "type": "object",
  "required": ["schema", "layout"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "layout-model/v2.0.0" },
    "layout": { "$ref": "#/$defs/layout" },
    "interlockings": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/interlocking" } },
    "machines": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/machine" } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "name": {
      "description": "An entity's own name within its scope: case preserved, compared case-folded, never a colon or a slash, no leading or trailing space.",
      "type": "string",
      "pattern": "^[^:/\\s](?:[^:/]*[^:/\\s])?$"
    },
    "qualifiedName": {
      "description": "A reference to an entity of an interlocking or machine scope: the scope's name, a colon, the entity's name. Always this form, in every scope.",
      "type": "string",
      "pattern": "^[^:/\\s](?:[^:/]*[^:/\\s])?:[^:/\\s](?:[^:/]*[^:/\\s])?$"
    },
    "layoutName": {
      "description": "A reference to an entity of the layout scope (an interlocking, machine, transport, code line or processor): its bare name.",
      "$ref": "#/$defs/name"
    },
    "chipRef": {
      "description": "A chip: processor/address, or processor/address/use where one address serves two uses.",
      "type": "string",
      "pattern": "^[^:/\\s](?:[^:/]*[^:/\\s])?/[^:/\\s]+(?:/[^:/\\s]+)?$"
    },
    "namedMap": {
      "description": "A dictionary keyed by entity name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" }
    },
    "settings": {
      "description": "Settings a person states on the entity; names and values are strings. Which ones apply is reference data (ADR 0008 §4.7).",
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "layout": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "railroad": { "type": "string" },
        "division": { "type": "string" },
        "description": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" },
        "transports": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/transport" } },
        "codelines": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/codeline" } },
        "processors": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/processor" } }
      }
    },
    "transport": {
      "description": "A declared bus of the layout scope (ADR 0005 S1): one serial line, one broker session. Its facts live here and nowhere else.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "description": "A transport kind key in the reference data: CMRI, MQTT, ..." },
        "host": { "$ref": "#/$defs/layoutName", "description": "The processor that drives the line (who polls); absent when not stated." },
        "params": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "codeline": {
      "description": "An encoding on a transport (ADR 0001 D1).",
      "type": "object",
      "required": ["encoding", "transport"],
      "additionalProperties": false,
      "properties": {
        "encoding": { "type": "string", "description": "An encoding key in the reference data: AAR, 506, ..." },
        "transport": { "$ref": "#/$defs/layoutName" },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "processor": {
      "description": "A processor is a layout-scope entity, named once for the whole layout (processor-cases §1). It attaches upward by transport and address when it is a node, and declares the chips below it.",
      "type": "object",
      "required": ["side"],
      "additionalProperties": false,
      "properties": {
        "side": { "enum": ["field", "office"] },
        "board": { "type": "string", "description": "A board key in the reference data." },
        "transport": { "$ref": "#/$defs/layoutName", "description": "The transport this processor attaches to as a node (a CMRInet node)." },
        "address": { "type": "string", "description": "Its address on that transport (the UA)." },
        "settings": { "$ref": "#/$defs/settings" },
        "chips": {
          "type": "object",
          "description": "Keyed by the chip's address on the processor's bus, or address/use where one address serves two uses.",
          "propertyNames": { "type": "string", "pattern": "^[^:/\\s]+(?:/[^:/\\s]+)?$" },
          "additionalProperties": { "$ref": "#/$defs/chip" }
        },
        "description": { "type": "string" }
      }
    },
    "chip": {
      "type": "object",
      "required": ["ic"],
      "additionalProperties": false,
      "properties": {
        "ic": { "type": "string", "description": "A chip key in the reference data: MCP23017, PCA9685, MAX7313, CMRI (a node's bits), ..." },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "interlocking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" },
        "controlPoints": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/controlPoint" } },
        "appliances": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/appliance" } },
        "track": { "type": "object", "description": "Track circuits, joints and policies as the view §4 defines them; open in v2.0.0 until the compiler fixes them." },
        "codelines": { "type": "array", "items": { "$ref": "#/$defs/codelineInstance" } },
        "fieldUnit": { "$ref": "#/$defs/unit" },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
        "geometry": { "type": "object", "description": "Placements and track polylines; open in v2.0.0 (view §4.7)." }
      }
    },
    "controlPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "milepost": { "type": "number" },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "appliance": {
      "type": "object",
      "required": ["appliance"],
      "additionalProperties": false,
      "properties": {
        "appliance": { "type": "string", "description": "An appliance key in the reference data: switch, mast, derail, lock, ..." },
        "style": { "type": "string" },
        "controlPoint": { "$ref": "#/$defs/qualifiedName" },
        "osCircuit": { "$ref": "#/$defs/qualifiedName" },
        "heads": {
          "type": "object",
          "description": "A head cannot exist without its mast, so it is contained (view §4), keyed by its letter.",
          "propertyNames": { "type": "string", "pattern": "^[A-Z]$" },
          "additionalProperties": { "$ref": "#/$defs/head" }
        },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "codelineInstance": {
      "description": "An encoding instance on an interlocking (a field station): the code line and its authored address (ADR 0001 D4).",
      "type": "object",
      "required": ["codeline"],
      "additionalProperties": false,
      "properties": {
        "codeline": { "$ref": "#/$defs/layoutName" },
        "address": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" }
      }
    },
    "unit": {
      "description": "The field unit of an interlocking or the office unit of a machine: the processor that runs its logic.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "$ref": "#/$defs/layoutName" },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "device": {
      "description": "One row of devices[]: one device instance. A row has no identity and nothing references it (ADR 0008 §4.5), so no id key exists.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "object",
          "required": ["appliance"],
          "additionalProperties": false,
          "properties": {
            "appliance": { "type": "string" },
            "style": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] }
          }
        },
        "serves": { "$ref": "#/$defs/qualifiedName", "description": "The appliance or circuit this device serves." },
        "shows": { "$ref": "#/$defs/qualifiedName", "description": "The indication this device shows (a lamp)." },
        "column": { "$ref": "#/$defs/qualifiedName", "description": "The machine column this desk device sits in." },
        "address": { "type": "string", "description": "The device's own address on a chain (a pixel index), ADR 0005 S4." },
        "settings": { "$ref": "#/$defs/settings" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "description": { "type": "string" }
      }
    },
    "binding": {
      "description": "One device function landed on one chip pin.",
      "type": "object",
      "required": ["function", "chip", "pin"],
      "additionalProperties": false,
      "properties": {
        "function": { "type": "string" },
        "chip": { "$ref": "#/$defs/chipRef" },
        "pin": { "type": "string" }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "panelStyle": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" },
        "columns": { "$ref": "#/$defs/namedMap", "additionalProperties": { "$ref": "#/$defs/column" } },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
        "officeUnit": { "$ref": "#/$defs/unit" },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
        "geometry": { "type": "object" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interlocking": { "$ref": "#/$defs/layoutName" },
        "settings": { "$ref": "#/$defs/settings" },
        "description": { "type": "string" }
      }
    },
    "attachment": {
      "description": "Which columns of this machine control which interlocking over which code line.",
      "type": "object",
      "required": ["interlocking", "codeline"],
      "additionalProperties": false,
      "properties": {
        "interlocking": { "$ref": "#/$defs/layoutName" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "codeline": { "$ref": "#/$defs/layoutName" }
      }
    },
    "provenance": {
      "description": "A property of the layout and nothing below it: what produced this file and the versions it was compiled against.",
      "type": "object",
      "required": ["sourceType", "compiler"],
      "additionalProperties": false,
      "properties": {
        "sourceType": { "type": "string", "description": "KiCad, Studio, hand, ..." },
        "compiler": {
          "type": "object", "required": ["name", "version"], "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "describe": { "type": "string" } }
        },
        "libraries": { "type": "object", "additionalProperties": { "type": "string" } },
        "referenceData": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
