{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldunit.org/schema/v1/evidence-ledger.schema.json",
  "title": "FieldUnit Evidence Ledger",
  "type": "object",
  "required": ["kind", "version", "id", "sources", "assertions"],
  "properties": {
    "kind": {
      "const": "evidence-ledger"
    },
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "uniqueItems": true
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "entityRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "interlockingPlant",
            "controlledPoint",
            "panelColumn",
            "trackCircuit",
            "switch",
            "signalMast",
            "signalRoute",
            "topologyNode",
            "detectionBlock",
            "transitSegment",
            "prototypeRedaction",
            "diagramElement",
            "deskAllocation"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "prototypePlan",
            "legacyConfiguration",
            "physicalDeskObservation",
            "operatorKnowledge",
            "modelingDecision",
            "photograph",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "disposition",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "$ref": "#/$defs/entityRef"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "oneOf": [
            {
              "$ref": "#/$defs/entityRef"
            },
            {
              "type": ["string", "number", "boolean", "null"]
            }
          ]
        },
        "disposition": {
          "enum": ["accepted", "provisional", "rejected", "incomplete"]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
